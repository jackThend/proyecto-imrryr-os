      "type": "local",
      "command": [
        "C:\\Users\\caosd\\Desktop\\Proyectos Software\\Proyecto Imrryr OS\\imrryr-os\\.venv\\Scripts\\python.exe",
        "C:\\Users\\caosd\\Desktop\\Proyectos Software\\Proyecto Imrryr OS\\imrryr-os\\mcp_server\\skills_server.py"
      ],
      "enabled": true
    }
