{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "imryyr-llm/imrryr-activo",
  "model": "imryyr-llm/imrryr-activo",
  "provider": {
    "imryyr-llm": {
      "name": "Imrryr LLM Gateway (LiteLLM)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "sk-imryyr-local"
      },
      "models": {
        "gemini-pro": {
          "name": "Gemini 1.5 Pro (vía LiteLLM)",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "gemini-flash": {
          "name": "Gemini 1.5 Flash (vía LiteLLM)",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "imrryr-activo": {
          "name": "Cuenta de IA activa (ver Ajustes > Cuentas de IA)",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "imrryr": {
      "type": "local",
      "command": [
        "C:\\Users\\caosd\\Desktop\\Proyectos Software\\Proyecto Imrryr OS\\imrryr-os\\.venv\\Scripts\\python.exe",
        "C:\\Users\\caosd\\Desktop\\Proyectos Software\\Proyecto Imrryr OS\\imrryr-os\\mcp_server\\skills_server.py"
      ],
      "enabled": true
    }
  },
  "agent": {
    "creativo": {
      "description": "Incuba ideas: cuando el usuario le manda una idea suelta (texto o audio, por WhatsApp o el dashboard), siempre la desarrolla primero en una versión detallada y bien escrita antes de guardarla — nunca guarda la idea tal cual llegó sin enriquecerla. Gestiona el banco de ideas (etapas: idea -> desarrollada -> proyecto -> archivada) y puede discutirlas y desarrollarlas más con el usuario usando el contexto de la memoria vectorial. Cambia una idea a proyecto cuando el usuario lo pide explícitamente (por texto o WhatsApp).",
      "mode": "subagent",
      "model": "imryyr-llm/imrryr-activo",
      "permission": {
        "read": "deny",
        "edit": "deny",
        "bash": "deny",
        "grep": "deny",
        "glob": "deny",
        "list": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "todowrite": "deny",
        "task": "deny",
        "external_directory": "deny",
        "question": "deny",
        "skill": {
          "imrryr_crear_evento": "allow",
          "imrryr_crear_semilla": "allow",
          "imrryr_listar_semillas": "allow",
          "imrryr_obtener_semilla": "allow",
          "imrryr_actualizar_semilla": "allow",
          "imrryr_cambiar_estado_semilla": "allow",
          "imrryr_adjuntar_archivo_semilla": "allow",
          "imrryr_consultar_memoria_vectorial": "allow",
          "imrryr_*": "deny",
          "*": "deny"
        }
      }
    },
