{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "imryyr-llm/gemini-flash",
  "model": "imryyr-llm/gemini-flash",
  "provider": {
    "imryyr-llm": {
      "name": "Imrryr LLM Gateway (LiteLLM)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "sk-imryyr-local"
      },
      "models": {
        "gemini-pro": {
          "name": "Gemini 1.5 Pro (vía LiteLLM)",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "gemini-flash": {
          "name": "Gemini 1.5 Flash (vía LiteLLM)",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
