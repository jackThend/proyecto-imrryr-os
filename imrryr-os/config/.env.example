# =====================================================================
# Imrryr OS — Plantilla de entorno (commiteable, SIN secretos)
# Copiar a config/.env y rellenar con tus credenciales locales.
# =====================================================================

# --- Proveedor de modelos (nube) ---
# Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Cuenta de IA activa (gestionada desde Ajustes > Cuentas de IA en el
# dashboard; esta línea se autogenera al activar una cuenta, no editar a mano) ---
IMRRYR_ACTIVE_API_KEY=

# --- Proveedor de modelos (local, opcional: requiere GPU + Ollama) ---
OLLAMA_HOST=http://localhost:11434

# --- Puertos locales ---
LITELLM_PORT=4000
OPENCODE_PORT=4040
WHATSAPP_LOCAL_PORT=5051

# --- Modelo por defecto ---
# Valores válidos: gemini-pro | gemini-flash | qwen-local (cuando Ollama esté activo)
DEFAULT_MODEL=gemini-pro

# --- Gateway WhatsApp (Fase 5) ---
# Número (con código de país, sin '+') al que el Guardia de Seguridad y los
# recordatorios proactivos envían alertas. El modo (local/cloud) y las
# credenciales de Cloud API se configuran desde el dashboard, no aquí
# (quedan en gateway/gateway_config.json, que nunca se commitea).
WHATSAPP_ADMIN_NUMBER=
