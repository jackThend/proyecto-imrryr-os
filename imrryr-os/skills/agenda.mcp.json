{
  "name": "agenda",
  "description": "Crea eventos con avisos a horas libres, responde qué tienes hoy/mañana/semana/mes o qué hiciste ayer, y dice si una fecha es feriado",
  "script": "skills/agenda.py",
  "arguments": [
    {
      "name": "accion",
      "type": "string",
      "description": "crear | que_tengo | que_hice | es_feriado | cancelar",
      "required": true
    },
    {
      "name": "titulo",
      "type": "string",
      "description": "Título del evento (para 'crear')",
      "required": false
    },
    {
      "name": "fecha",
      "type": "string",
      "description": "Fecha ISO 8601 (YYYY-MM-DD)",
      "required": false
    },
    {
      "name": "hora",
      "type": "string",
      "description": "Hora HH:MM del evento, default 09:00",
      "required": false
    },
    {
      "name": "duracion",
      "type": "integer",
      "description": "Duración en minutos, default 60",
      "required": false
    },
    {
      "name": "descripcion",
      "type": "string",
      "description": "Descripción opcional del evento",
      "required": false
    },
    {
      "name": "avisos",
      "type": "string",
      "description": "Horarios de aviso por WhatsApp separados por coma, ej. '08:00,17:00' — solo se avisa si el usuario los pide",
      "required": false
    },
    {
      "name": "cuando",
      "type": "string",
      "description": "hoy | mañana | semana | mes (para que_tengo/es_feriado)",
      "required": false
    },
    {
      "name": "anio",
      "type": "integer",
      "description": "Año para 'que_tengo' con cuando=mes (default: año actual)",
      "required": false
    },
    {
      "name": "mes",
      "type": "integer",
      "description": "Mes (1-12) para 'que_tengo' con cuando=mes (default: mes actual)",
      "required": false
    },
    {
      "name": "exportar_ics",
      "type": "boolean",
      "description": "Además generar un archivo .ics del evento",
      "required": false
    },
    {
      "name": "evento_id",
      "type": "integer",
      "description": "ID del evento (para cancelar)",
      "required": false
    }
  ]
}
